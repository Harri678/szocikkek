<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     <form action="/filter">
          <label for="minViews">Min: </label>
          <input type="number" id="minViews" name="minViews" value="<%= minViews  %> ">
          <button type="submit">Submit</button>
     </form>
    <table>
        <thead>
            <tr>
                <th>Szocikk cime</th>
                <th>Latogatasok szama</th>
            </tr>
        </thead>
        <tbody>
            <% articles.forEach(article => { %>
               <% if(article.views > minViews) {%> 
                <tr>
                    <td><a href="<%= article.url %> "><%= article.title %> </a> </td>
                    <td><%= article.views %> </td>
                </tr>
                <% } %> 
            <%  }); %>  
        </tbody>
    </table>

    <a href="/filter">Filter</a>
    <a href="/new">New</a>

</body>
</html>